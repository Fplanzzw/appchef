# ===== 通义千问（必需）=====
# 阿里云百炼平台申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Tavily 联网搜索（必需）=====
# 申请：https://tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ===== 高德地图（可选，用于定位推荐当地菜）=====
# 申请：https://console.amap.com/
GAODE_KEY=xxxxxxxxxxxxxxxx
GAODE_BASE_URL=https://restapi.amap.com/v3
GAODE_TIMEOUT=8

# ===== 阿里云 OSS（可选，用于图片上传）=====
OSS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxx
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ===== 记忆向量（可选，长期记忆去重用）=====
EMBEDDING_MODEL=text-embedding-v4
